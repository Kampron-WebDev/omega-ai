# Copy to .env.local and fill in. Server variables are validated by lib/env.ts.

# Clerk publishable key (Clerk dashboard → API keys). Exposed to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (Clerk dashboard → API keys). Server only.
CLERK_SECRET_KEY=
# Path of the sign-in page. Optional; defaults to /sign-in.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
# Path of the sign-up page. Optional; defaults to /sign-up.
NEXT_PUBLIC_CLERK_SIGN_UP_URL=

# PostgreSQL connection string (postgres://…) or a Prisma Postgres URL (prisma+postgres://…).
DATABASE_URL=

# Liveblocks secret key (Liveblocks dashboard → API keys). Server only.
LIVEBLOCKS_SECRET_KEY=
