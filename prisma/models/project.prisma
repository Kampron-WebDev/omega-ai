enum ProjectStatus {
  DRAFT
  ARCHIVED
}

/// An architecture project owned by a single Clerk user.
model Project {
  id             String        @id @default(cuid())
  ownerId        String
  name           String
  description    String?
  status         ProjectStatus @default(DRAFT)
  /// Blob reference for the canvas snapshot (`canvas/{projectId}.json`).
  canvasJsonPath String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  collaborators ProjectCollaborator[]

  @@index([ownerId])
  @@index([createdAt])
}

/// Grants a non-owner access to a project, addressed by email.
model ProjectCollaborator {
  id        String   @id @default(cuid())
  projectId String
  email     String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, email])
  @@index([email])
  @@index([projectId, createdAt])
}
